---
interface Props { group: string; items: string[] }
const { group, items } = Astro.props;
---
<div class="grid gap-2 sm:grid-cols-[7rem_1fr] sm:gap-6">
  <h3 class="pt-1 font-mono text-xs text-muted">{group}</h3>
  <ul class="flex flex-wrap gap-2">
    {items.map((item) => <li class="rounded-md border border-line px-2.5 py-0.5 text-sm">{item}</li>)}
  </ul>
</div>
