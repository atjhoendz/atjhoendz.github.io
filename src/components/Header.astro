---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="flex items-center justify-between gap-4 py-8">
  <a href="/" class="font-semibold tracking-tight hover:no-underline">{profile.shortName}</a>
  <nav class="flex items-center gap-1 text-sm text-muted sm:gap-4">
    <ul class="hidden items-center gap-4 sm:flex">
      {links.map((l) => <li><a href={l.href} class="hover:text-fg hover:no-underline">{l.label}</a></li>)}
    </ul>
    <ThemeToggle />
  </nav>
</header>
