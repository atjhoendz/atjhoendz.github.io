---
interface Props { id: string; title: string; num: string }
const { id, title, num } = Astro.props;
---
<section id={id} class="scroll-mt-8 py-12">
  <h2 data-reveal class="mb-8 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-muted">
    <span class="text-accent">{num}</span>
    <span>·</span>
    {title}
    <span class="h-px flex-1 bg-gradient-to-r from-accent/60 to-transparent"></span>
  </h2>
  <slot />
</section>
