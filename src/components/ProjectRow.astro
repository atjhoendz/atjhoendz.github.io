---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project: p } = Astro.props;
---
<li class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-6">
  <span class="pt-0.5 font-mono text-xs text-muted">{p.year}</span>
  <div>
    <h3 class="font-medium">
      {p.url ? (
        <a href={p.url} target="_blank" rel="noopener noreferrer">
          {p.title} <span aria-hidden="true" class="text-muted">↗</span>
        </a>
      ) : p.title}
    </h3>
    <p class="text-sm text-muted">{p.role}</p>
    <p class="mt-2 text-[15px]">{p.description}</p>
    <p class="mt-2 text-sm text-muted">{p.stack.join(' · ')}</p>
  </div>
</li>
