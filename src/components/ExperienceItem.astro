---
import type { Experience, YearBlock } from '../data/experience';
interface Props { item: Experience; index: number }
const { item: e, index } = Astro.props;
const current = e.end.toLowerCase() === 'present';

const VISIBLE_YEARS = 3;
const years = e.years ?? [];
const shown = years.slice(0, VISIBLE_YEARS);
const hidden = years.slice(VISIBLE_YEARS);
const hiddenRange = hidden.length ? `${hidden.at(-1)!.year} – ${hidden[0].year}` : '';
---
<li data-reveal style={`--i:${index}`} class="timeline-item relative pb-8 pl-9 last:pb-0">
  <span
    aria-hidden="true"
    class:list={[
      'absolute top-6 left-0 size-3.5 rounded-full border-2 border-accent',
      current ? 'pulse bg-accent' : 'bg-bg',
    ]}
  ></span>
  <div class="rounded-2xl border border-line bg-card p-5 shadow-soft transition duration-300 hover:border-accent/40 sm:p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold leading-snug">
        {e.role}
        <span class="font-normal text-muted">·</span>
        {e.companyUrl ? (
          <a href={e.companyUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">{e.company}</a>
        ) : <span class="text-accent">{e.company}</span>}
      </h3>
      {current && (
        <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[11px] font-medium text-accent">Current</span>
      )}
    </div>
    <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-muted">
      {e.start} – {e.end}{e.location && ` · ${e.location}`}
    </p>
    {e.about && <p class="mt-3 text-[15px] text-muted">{e.about}</p>}

    {e.stats && (
      <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {e.stats.map((s) => (
          <div class="stat rounded-xl border border-line px-2.5 py-2.5 sm:px-3 sm:py-3">
            <dt class="sr-only">{s.label}</dt>
            <dd class="gradient-text text-[15px] font-bold leading-tight tracking-tight sm:text-[17px]">{s.value}</dd>
            <dd class="mt-1 text-xs leading-snug text-muted">{s.label}</dd>
          </div>
        ))}
      </dl>
    )}

    {years.length > 0 && (
      <div class="mt-6 space-y-5">
        {shown.map((y: YearBlock) => (
          <div class="year-row grid gap-1 sm:grid-cols-[3.5rem_1fr] sm:gap-4">
            <p class="font-mono text-xs font-semibold text-accent sm:pt-0.5">{y.year}</p>
            <ul class="list-disc space-y-1.5 border-l border-line pl-5 text-[15px] marker:text-accent sm:pl-6">
              {y.items.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))}
        {hidden.length > 0 && (
          <details class="group/more">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-line px-3 py-1 text-sm font-medium text-muted transition hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden">
              <span class="group-open/more:hidden">Show {hiddenRange}</span>
              <span class="hidden group-open/more:inline">Hide {hiddenRange}</span>
              <span aria-hidden="true" class="transition group-open/more:rotate-180">↓</span>
            </summary>
            <div class="mt-5 space-y-5">
              {hidden.map((y: YearBlock) => (
                <div class="year-row grid gap-1 sm:grid-cols-[3.5rem_1fr] sm:gap-4">
                  <p class="font-mono text-xs font-semibold text-accent sm:pt-0.5">{y.year}</p>
                  <ul class="list-disc space-y-1.5 border-l border-line pl-5 text-[15px] marker:text-accent sm:pl-6">
                    {y.items.map((h) => <li>{h}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    )}

    {!e.years && e.highlights && (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] text-muted marker:text-accent">
        {e.highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <ul class="mt-6 flex flex-wrap gap-1.5">
      {e.stack.map((t) => (
        <li class="rounded-full bg-accent-2/10 px-2.5 py-0.5 text-xs font-medium text-accent-2">{t}</li>
      ))}
    </ul>
  </div>
</li>

<style>
  .stat {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 7%, transparent),
      color-mix(in srgb, var(--accent-2) 7%, transparent)
    );
  }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 2.25rem;
    bottom: -1.5rem;
    width: 2px;
    background: var(--line);
  }
  .timeline-item:last-child::before {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s ease-out infinite;
    }
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); }
    70%, 100% { box-shadow: 0 0 0 10px transparent; }
  }
</style>
