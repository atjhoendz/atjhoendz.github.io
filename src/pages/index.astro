---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { skills } from '../data/skills';

const heroLinks = [
  ...profile.socials.filter((s) => s.label !== 'Facebook'),
  { label: 'Email', url: `mailto:${profile.email}` },
];
---
<Base>
  <section id="about" class="scroll-mt-8 pt-10 pb-6 sm:pt-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{profile.name}</h1>
    <p class="mt-2 text-muted">{profile.role}</p>
    <p class="mt-6 max-w-[60ch]">{profile.summary}</p>
    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {heroLinks.map((l) => (
        <li>
          <a href={l.url} class="underline decoration-line hover:decoration-accent"
            {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Section id="work" title="Work">
    <ol class="space-y-10">
      {projects.map((p) => <ProjectRow project={p} />)}
    </ol>
  </Section>

  <Section id="skills" title="Skills">
    <div class="space-y-5">
      {skills.map((s) => <SkillGroup group={s.group} items={s.items} />)}
    </div>
  </Section>

  <Section id="contact" title="Contact">
    <p class="text-lg font-medium">Let's get in touch.</p>
    <p class="mt-2 text-muted">
      Have a project or an opportunity? Email me at
      <a href={`mailto:${profile.email}`} class="text-fg underline decoration-line hover:decoration-accent">{profile.email}</a>.
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {profile.socials.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="underline decoration-line hover:decoration-accent">{s.label}</a></li>
      ))}
    </ul>
  </Section>
</Base>
