---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Skills from '../components/Skills.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { experience } from '../data/experience';

const profileLinks = profile.socials.filter((s) => s.label !== 'Facebook');
---
<Base>
  <section id="about" class="relative pt-12 pb-10 sm:pt-20 sm:pb-16">
    <div aria-hidden="true" class="pointer-events-none absolute -inset-x-40 -top-40 bottom-0 -z-10">
      <div class="dot-grid absolute inset-0"></div>
      <div class="blob size-80 -top-10 right-24 bg-accent"></div>
      <div class="blob blob-2 size-72 top-40 left-24 bg-accent-2"></div>
    </div>

    <p class="font-mono text-sm text-muted">
      <span class="wave inline-block origin-[70%_70%]">👋</span> Hi, I'm
    </p>
    <h1 class="gradient-text mt-2 pb-1 text-4xl font-bold tracking-tight sm:text-6xl">{profile.name}</h1>
    <p class="mt-3 text-lg font-medium sm:text-xl">
      {profile.role}
      <span class="ml-2 inline-flex translate-y-[-2px] items-center gap-1 rounded-full border border-line bg-card/70 px-2.5 py-0.5 align-middle text-xs font-normal text-muted backdrop-blur">
        📍 {profile.location}
      </span>
    </p>
    <p class="mt-6 max-w-[60ch] text-[17px] text-muted">{profile.summary}</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li><a href={`mailto:${profile.email}`} class="btn-primary">Email me <span aria-hidden="true">→</span></a></li>
      {profileLinks.map((l) => (
        <li><a href={l.url} class="pill" target="_blank" rel="noopener noreferrer">{l.label}</a></li>
      ))}
    </ul>
  </section>

  <Section id="skills" title="Skills" num="01">
    <Skills />
  </Section>

  <Section id="work" title="Work" num="02">
    <ol>
      {experience.map((e, i) => <ExperienceItem item={e} index={i} />)}
    </ol>
  </Section>

  <Section id="projects" title="Projects" num="03">
    <ol class="grid gap-5 sm:grid-cols-2">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ol>
  </Section>

  <Section id="contact" title="Contact" num="04">
    <div
      data-reveal
      class="relative overflow-hidden rounded-3xl border border-line p-8 text-center shadow-soft sm:p-12"
      style="background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 12%,var(--card)),color-mix(in srgb,var(--accent-2) 12%,var(--card)))"
    >
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Let's build something together</h3>
      <p class="mx-auto mt-3 max-w-[44ch] text-muted">
        Have a project or an opportunity in mind? My inbox is always open.
      </p>
      <a href={`mailto:${profile.email}`} class="btn-primary mt-6 px-6 py-2.5 text-base">Say hello <span aria-hidden="true">→</span></a>
      <p class="mt-3 text-sm text-muted">{profile.email}</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {profile.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="pill">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </Section>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .wave {
      animation: wave 2.4s ease-in-out 0.6s 2;
    }
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
</style>
