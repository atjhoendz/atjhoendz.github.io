---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="py-24">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-muted">The page you're looking for doesn't exist.</p>
    <p class="mt-6"><a href="/" class="btn-primary">← Back home</a></p>
  </section>
</Base>
