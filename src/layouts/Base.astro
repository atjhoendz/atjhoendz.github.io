---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string }
const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.name}'s personal site and portfolio.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon.png', Astro.site)} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
      // Clean up the service worker left behind by the old Nuxt site.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (rs) {
          rs.forEach(function (r) { r.unregister(); });
        });
      }
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-[680px] px-4">
      <Header />
      <main>
        <slot />
      </main>
      <footer class="border-t border-line py-8 text-sm text-muted">
        © {new Date().getFullYear()} {profile.name}
      </footer>
    </div>
  </body>
</html>
