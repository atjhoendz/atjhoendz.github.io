---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string }
const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.name}, ${profile.role} with 5+ years building Go services, event-driven systems and search infrastructure at scale.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon.png', Astro.site)} />
    <meta name="theme-color" content="#fbf8f3" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        d.dataset.theme = t === 'dark' ? 'dark' : 'light';
      })();
      // Clean up the service worker left behind by the old Nuxt site.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (rs) {
          rs.forEach(function (r) { r.unregister(); });
        });
      }
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-[760px] px-4">
      <Header />
      <main>
        <slot />
      </main>
      <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-8 text-sm text-muted">
        <p>© {new Date().getFullYear()} {profile.name} · Built with <a href="https://astro.build" class="link" target="_blank" rel="noopener noreferrer">Astro</a></p>
        <a href="#top" class="hover:text-accent">Back to top ↑</a>
      </footer>
    </div>
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
